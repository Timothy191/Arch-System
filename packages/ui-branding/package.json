{
  "name": "@repo/ui-branding",
  "description": "Branding assets, logos, and theme-specific components for global branding consistency",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@repo/theme": "1.0.0",
    "@repo/ui-primitives": "1.0.0"
  },
  "peerDependencies": {
    "next": "^16.2.6",
