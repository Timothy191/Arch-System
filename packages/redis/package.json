{
  "name": "@repo/redis",
  "description": "Redis client, caching helpers, cache statistics, TTL registry, sessions with privilege revocation, streams, distributed locks, analytics counters, RediSearch vector search and capability probing",
  "version": "1.0.0",
  "dependencies": {
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "1.0.0",
    "@types/node": "catalog:",
    "jest": "^30.0.0",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./cache": "./src/cache.ts",
    "./session": "./src/session.ts",
    "./search": "./src/search.ts",
    "./analytics": "./src/analytics.ts",
    "./raw": "./src/raw.ts"
  },
  "main": "./src/index.ts",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .turbo",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "type-check": "tsc --noEmit",
