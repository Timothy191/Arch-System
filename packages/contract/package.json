{
  "name": "@repo/contract",
  "description": "API type definitions and validation schemas using Zod for shared TypeScript types across frontend and backend",
  "version": "1.0.0",
  "devDependencies": {
    "@repo/typescript-config": "1.0.0",
    "@types/node": "catalog:",
    "openapi-zod-client": "^1.18.3",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./validation": {
      "types": "./src/validation.ts",
      "default": "./src/validation.ts"
    },
    "./schemas/*": {
      "types": "./src/schemas/*.schema.ts",
      "default": "./src/schemas/*.schema.ts"
    },
    "./types/*": {
      "types": "./src/types/*.types.ts",
      "default": "./src/types/*.types.ts"
    }
  },
  "main": "./src/index.ts",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .nx",
    "lint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "type-check": "tsc --noEmit",
    "openapi:generate": "SPEC_FILE=./openapi.generated.json node scripts/generate-openapi-types.js",
    "openapi:validate": "node scripts/validate-contract.js",
    "generate-zod": "openapi-zod-client openapi.generated.json -o src/generated/schemas.ts",
    "test:contract:health": "node scripts/test-contract-health.js"
  },
  "types": "./src/index.ts"
}
