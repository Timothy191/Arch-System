{
  "name": "@repo/contract",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./validation": "./src/validation/index.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "1.0.0",
    "openapi-typescript": "^7.13.0",
    "openapi-zod-client": "^1.13.0",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "openapi:generate": "node scripts/generate-openapi-types.js",
    "openapi:validate": "node scripts/validate-contract.js",
    "generate-zod": "openapi-zod-client openapi.generated.json -o src/generated/schemas.ts",
    "test:contract:health": "jest tests/contract-health.test.ts"
  }
}
