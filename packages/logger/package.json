{
  "name": "@repo/logger",
  "description": "Structured logging with Pino — server, browser, and Next.js helpers",
  "version": "1.0.0",
  "dependencies": {
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "1.0.0",
    "@types/node": "catalog:",
    "jest": "^30.2.0",
    "next": "^16.4.1",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./browser": "./src/browser.ts",
    "./next": "./src/next.ts"
  },
  "main": "./src/index.ts",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .turbo",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "test": "jest --config jest.config.js --passWithNoTests --runInBand",
    "type-check": "tsc --noEmit"
  },
  "types": "./src/index.ts"
}
