{
  "name": "@repo/ui-primitives",
  "description": "Low-level primitive UI components built on shadcn/Radix - buttons, inputs, cards, dialogs, etc.",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@repo/theme": "1.0.0"
  },
  "peerDependencies": {
    "next": "^16.2.6",
    "react": "^19",
    "react-dom": "^19"
  },
  "private": true,
  "scripts": {
    "clean": "rm -rf dist .turbo",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "devDependencies": {
    "@repo/typescript-config": "1.0.0"
  }
}
