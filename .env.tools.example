# ──────────────────────────────────────────────
# Arch-Systems — Docker Tools Environment Configuration
# ──────────────────────────────────────────────
# Usage: Used by infra/docker/compose.tools.yml
# Services: Langfuse (3003), Langfuse DB, Langfuse Redis, Plantcor Redis (6381)
# ──────────────────────────────────────────────

TOOL_ADMIN_EMAIL=admin@plantcor.os
TOOL_ADMIN_PASSWORD=replace_with_a_unique_admin_password

# Langfuse PostgreSQL Database
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=replace_with_a_unique_database_password
LANGFUSE_DB_NAME=langfuse

# Required by the production Redis override; replace with a unique secret.
REDIS_PASSWORD=replace_with_a_unique_password

# Langfuse Security & Auth Secrets
# TOOL_ENCRYPTION_KEY must be a 64-character hex string (32 bytes / 256 bits)
TOOL_ENCRYPTION_KEY=replace_with_64_hex_characters
TOOL_NEXTAUTH_SECRET=replace_with_a_random_nextauth_secret
TOOL_SALT=replace_with_a_random_salt
