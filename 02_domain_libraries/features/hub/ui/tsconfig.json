{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../../../../",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "paths": {
      "@repo/theme": ["01_platform_packages/theme/src/index.ts"],
      "@repo/theme/*": ["01_platform_packages/theme/src/*"]
