{
  "mcpServers": {
    "redis": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-redis", "redis://localhost:6381"]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
      ]
    },
    "ripgrep": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-ripgrep"]
    },
    "codebase-memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "upstash": {
      "type": "http",
      "url": "https://mcp.upstash.com/mcp"
    },
    "workos": {
      "type": "http",
      "url": "https://mcp.workos.com/mcp",
      "headers": {
        "Authorization": "Bearer ${WORKOS_API_KEY}"
      }
    },
    "sixtyfour-intelligence": {
      "type": "http",
      "url": "https://mcp.sixtyfour.ai/mcp",
      "headers": {
        "x-api-key": "${SIXTYFOUR_API_KEY}"
      }
    },
    "windsor": {
      "type": "http",
      "url": "https://mcp.windsor.ai/",
      "headers": {
        "Authorization": "Bearer ${WINDSOR_API_KEY}"
      }
    }
  }
}
