{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "."
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "!**/.next",
      "!**/dist",
      "!**/coverage",
      "!**/.turbo",
      "!**/storybook-static",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.ci-local",
      "!**/.junie",
      "!**/.pnpm-store"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.generated.*", "**/variables-generated.css"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/setupTests.ts",
        "**/jest.setup.ts",
        "**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useKeyWithClickEvents": "off",
        "useMediaCaption": "off",
        "useValidAnchor": "off",
        "noAutofocus": "off",
        "noSvgWithoutTitle": "off",
        "useAriaPropsSupportedByRole": "off",
        "noLabelWithoutControl": "off",
        "useSemanticElements": "off",
        "noInteractiveElementToNoninteractiveRole": "off",
        "noNoninteractiveElementToInteractiveRole": "off",
        "useButtonType": "off",
        "noStaticElementInteractions": "off",
        "useFocusableInteractive": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off",
        "noArrayIndexKey": "off",
        "useIterableCallbackReturn": "off",
        "noThenProperty": "off",
        "noEmptyBlockStatements": "off",
        "noReactSpecificProps": "off",
        "noImplicitAnyLet": "off",
        "noConsole": "off",
        "noEvolvingTypes": "off",
        "noConfusingLabels": "off",
        "noShadowRestrictedNames": "off",
        "noDoubleEquals": "off",
        "noUndeclaredEnvVars": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off",
        "useTemplate": "off",
        "useImportType": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "off",
        "noEmptyPattern": "off",
        "noUnusedFunctionParameters": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off",
        "noImgElement": "off"
      },
      "complexity": {
        "noStaticOnlyClass": "off"
      },
      "security": {
        "noGlobalEval": "off"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "attributes": ["classList", "wrapperClassName", "iconClassName", "contentClassName"],
            "functions": ["cn", "clsx", "cva", "twMerge"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
