{
  "name": "arch-systems",
  "version": "1.5.1",
  "commitlint": {
    "extends": [
      "./toolchain/tools/commitlint.config.mjs"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@modelcontextprotocol/sdk": "catalog:",
    "@nx/eslint-plugin": "^22.7.5",
    "@nx/storybook": "^22.7.5",
    "@nx/vite": "22.7.5",
    "@nx/web": "22.7.5",
    "@playwright/test": "^1.60.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/test-runner": "^0.24.4",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "^1.15.40",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-playwright": "^2.2.2",
    "bundlesize": "^0.18.1",
    "eslint": "catalog:",
    "eslint-plugin-only-warn": "^1.2.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "knip": "^5.45.0",
    "lint-staged": "^17.0.7",
    "markdownlint-cli": "^0.41.0",
    "nx": "22.7.5",
    "preflight": "0.2.0",
    "prettier": "catalog:",
    "secretlint": "^13.0.2",
    "storybook": "^8.6.14",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "supabase": "catalog:",
    "swagger-jsdoc": "^6.3.0",
    "syncpack": "^13.0.4",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "typescript": "~5.9.2",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "markdownlint": {
    "config": "toolchain/tools/.markdownlint.json"
  },
  "overrides": {
    "handlebars": ">=4.7.9",
    "brace-expansion": ">=2.0.2",
    "minimatch": ">=9.0.7",
    "braces": ">=3.0.3",
    "serialize-javascript": ">=7.0.3",
    "kysely": ">=0.28.17",
    "tmp": ">=0.2.6",
    "uuid": ">=11.1.1",
    "smol-toml": ">=1.3.1",
    "esbuild": ">=0.25.0",
    "@babel/runtime": ">=7.26.10",
    "js-yaml@^3.0.0": ">=3.14.2",
    "js-yaml@^4.0.0": ">=4.1.1"
  },
  "packageManager": "pnpm@9.15.9",
  "private": true,
"scripts": {
    "analyze": "ANALYZE=true pnpm --filter portal build",
    "bundlesize": "bundlesize",
    "audit:design": "node tools/design-audit.cjs",
    "audit:rls": "node tools/audit-rls.cjs",
    "build": "node ops/sync-assets-smart.cjs && nx run-many -t build",
    "commitlint": "commitlint --edit",
    "db:docs": "bash ops/generate-db-docs.sh",
    "deploy": "bash ops/deploy.sh",
    "deploy:dev": "bash ops/deploy-dev.sh",
    "deploy:local": "bash ops/deploy.sh local",
    "deploy:production": "bash ops/deploy.sh production",
    "deploy:rollback": "bash ops/deploy.sh production --rollback",
    "deploy:staging": "bash ops/deploy.sh staging",
    "deps:check": "syncpack list-mismatches --config config/tools/.syncpackrc.js",
    "deps:fix": "syncpack fix-mismatches --config config/tools/.syncpackrc.js",
    "deps:lint": "syncpack lint --config config/tools/.syncpackrc.js",
    "dev": "node ops/sync-assets-smart.cjs && bash ops/dev.sh",
    "dev:minimal": "bash ops/dev-minimal.sh",
    "ensure-reachability": "python3 ops/ensure_reachability.py",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "fresh-start": "bash ops/deploy.sh local --clean",
    "inngest:dev": "bash ops/inngest-dev.sh",
    "memory:embed": "python3 .ai_content/.memory/.kilo-memory/scripts/generate-embeddings.py",
    "memory:search": "python3 .ai_content/.memory/.kilo-memory/scripts/semantic-search.py",
    "redis:dev": "bash cache/scripts/start.sh",
    "redis:stop": "bash cache/scripts/stop.sh",
    "redis:status": "bash cache/scripts/status.sh",
    "knip": "knip --config config/tools/knip.json --no-config-hints",
    "knip:fix": "knip --config config/tools/knip.json --fix --no-config-hints",
    "lint": "nx run-many -t lint",
    "lint:root": "eslint . --max-warnings 0 --ignore-pattern apps --ignore-pattern pkgs --no-error-on-unmatched-pattern",
    "lint:styles": "stylelint '**/*.{css,scss}' --ignore-path .gitignore",
    "md:fix": "markdownlint \"**/*.md\" --fix --ignore node_modules --ignore '**/node_modules' --ignore '**/.next' --ignore '**/dist'",
    "monitor": "bash ops/monitor-hud.sh",
    "monitor:bundle": "bash ops/monitor-bundle-size.sh",
    "monitor:grafana": "docker compose -f docker/docker-compose.monitoring.yml up -d",
    "monitor:grafana-stop": "docker compose -f docker/docker-compose.monitoring.yml down",
    "policy:migrations:check": "node tools/check-migration-sync.cjs",
    "policy:migrations:sync": "node tools/sync-migrations.cjs",
    "md:lint": "markdownlint \"**/*.md\" --ignore node_modules --ignore '**/node_modules' --ignore '**/.next' --ignore '**/dist'",
    "policy:check": "node tools/policy-compiler.cjs --check && pnpm policy:security --ci",
    "policy:gen": "node tools/policy-compiler.cjs",
    "policy:security": "node tools/enforce-security-checks.cjs",
    "prepare": "husky",
    "quality": "nx run-many -t lint type-check test lint:tokens lint:css && pnpm lint:root && pnpm lint:styles && pnpm format:check && pnpm deps:lint && pnpm knip && pnpm policy:check && pnpm audit:rls && pnpm audit:design",
    "shutdown": "bash ops/shutdown.sh",
    "sync-assets": "node ops/sync-assets-smart.cjs",
    "test": "nx run-many -t test",
    "test:a11y": "pnpm --filter @repo/ui test-storybook:a11y",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --grep 'theme.smoke'",
    "type-check": "nx run-many -t type-check",
    "ui": "pnpm --filter @repo/ui ui"
  },
  "syncpack": {
    "config": "toolchain/tools/.syncpackrc.js"
  },
  "type": "module",
  "volta": {
    "node": "24.15.0",
    "pnpm": "9.15.9"
  }
}
