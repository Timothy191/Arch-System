{
  "mcpServers": {
    "codebase-memory": {
      "command": "npx",
      "args": ["-y", "@sourcery/codebase-memory-mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp-server"]
    },
    "knowledge-rail": {
      "command": "npx",
      "args": ["-y", "knowledge-rail-mcp"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp"]
    },
    "nx-mcp": {
      "command": "npx",
      "args": ["-y", "nx-mcp"]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
      ]
    }
  }
}
