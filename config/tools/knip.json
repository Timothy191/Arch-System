{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": [
    "secretlint",
    "@modelcontextprotocol/sdk",
    "@secretlint/secretlint-rule-preset-recommend",
    "preflight",
    "@repo/eslint-config",
    "@typescript-eslint/parser",
    "eslint-plugin-boundaries",
    "eslint-plugin-only-warn",
    "turbo",
    "bundlesize",
    "wait-on",
    "serve",
    "web-vitals",
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "commitlint-config-.",
    "commitlint-config-",
    "tslib",
    "vitepress",
    "swagger-jsdoc",
    "vite-tsconfig-paths",
    "squawk-cli",
    "gpt-tokenizer",
    "^@repo/.*"
  ],
  "ignoreBinaries": [
    "jest",
    "python3",
    "psql",
    "wait-on",
    "serve",
    "poetry",
    "uv",
    "lighthouse",
    "repowise",
    "repomix",
    "xdg-open",
    "open",
    "redis-cli",
    "tsx",
    "chokidar"
  ],
  "ignore": [
    "**/jest*.config.*",
    "**/postcss.config.*",
    "packages/contract/scripts/generate-spec-local.js",
    "packages/ui/storybook-static/**",
    "k6/**",
    "docs/examples/**",
    "e2e/helpers/**",
    "config/tools/**",
    "services/integrations/**",
    "scripts/autonomous-ui-delegator.mjs",
    "scripts/codemods/remove-dark-classes.cjs",
    "scripts/sync-integrations-mcp.mjs",
    "scripts/sync-mcp-config.js",
    "scripts/test-langfuse-tracing.mjs",
    "scripts/validate-mcp-servers.js",
    "scripts/video-generator/render-videos.mjs",
    "scripts/verify-c66-database.mjs",
    "scripts/seeds/seed-access-logs.mjs"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,js}", ".eslintrc.{js,cjs}"],
      "project": ["scripts/**/*.{ts,js}"],
      "ignore": ["tsconfig.base.json"]
    },
    "apps/portal": {
      "entry": [
        "app/**/layout.tsx",
        "app/**/page.tsx",
        "app/**/route.ts",
        "server/proxy.ts",
        "plugins/rust-telemetry-engine/index.tsx",
        "hooks/useOfflineQueue.ts",
        "lib/ai/embeddings.ts",
        "lib/api/rate-limit-middleware.ts",
        "flags/index.ts",
        "workflows/index.ts",
        ".eslintrc.{js,cjs}"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "features/**/*.{ts,tsx}",
        "flags/**/*.{ts,tsx}",
        "hooks/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "plugins/**/*.{ts,tsx}",
        "workflows/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "autoprefixer",
        "postcss",
        "tailwindcss",
        "@ducanh2912/next-pwa",
        "@opentelemetry/auto-instrumentations-node",
        "@opentelemetry/sdk-node",
        "@opentelemetry/semantic-conventions",
        "@opentelemetry/sdk-trace-node",
        "@repo/shared/hooks",
        "@repo/agents",
        "@repo/auth/data-access",
        "@repo/auth/ui",
        "@repo/auth/utils",
        "@repo/departments/data-access",
        "@repo/departments/ui",
        "@repo/hub/ui",
        "@repo/shared/data-access",
        "@repo/shared/utils",
        "@repo/typescript-config",
        "@tailwindcss/typography",
        "tailwindcss-animate"
      ],
      "ignore": [
        "lib/observability/metrics.ts",
        "features/analytics/components/ReportTemplate.tsx",
        "components/WebVitalsReporter.tsx",
        "lib/ai/embeddings.ts",
        "lib/api/rate-limit-middleware.ts",
        "lib/performance-analyzer.ts",
        "plugins/rust-telemetry-engine/index.tsx",
        "server/proxy.ts",
        "lib/server-cache.ts",
        "app/actions.ts",
        "lib/actions/shift-closeout.ts",
        "components/control-room/C66MachineOperatorScanner.tsx",
        "lib/control-room-shift-report.ts",
        "app/(departments)/[department]/reports/actions.ts",
        "app/(departments)/access-control/actions/badges.ts",
        "app/(departments)/access-control/actions/gates.ts"
      ]
    },
    "packages/theme": {
      "entry": ["src/tokens/*.ts", "src/react/*.tsx", ".eslintrc.{js,cjs}"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignore": ["src/tokens/colors.ts", "src/tokens/motion.ts"],
      "ignoreDependencies": ["@types/react-dom", "@tailwindcss/typography"]
    },
    "packages/database": {
      "entry": [".eslintrc.{js,cjs}"],
      "project": ["migrations/**/*.sql"],
      "ignore": ["supabase/migrations/**"],
      "ignoreDependencies": ["supabase"]
    },
    "packages/eslint-config": {
      "entry": ["*.js"],
      "project": ["*.js"],
      "ignoreDependencies": ["eslint-import-resolver-typescript"]
    },
    "packages/supabase": {
      "entry": [
        "src/index.ts",
        "src/server.ts",
        "src/client.ts",
        "src/middleware.ts",
        "src/service-role.ts",
        "src/seed.ts",
        ".eslintrc.{js,cjs}"
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["src/database.types.ts"]
    },
    "packages/errors": {
      "entry": ["src/index.ts", ".eslintrc.{js,cjs}"],
      "project": ["src/**/*.ts"]
    },
    "packages/typescript-config": {
      "entry": ["*.json"],
      "project": ["*.json"],
      "ignoreDependencies": ["next"]
    },
    "packages/utils": {
      "entry": ["src/index.ts", ".eslintrc.{js,cjs}"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/*.tsx", ".eslintrc.{js,cjs}"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/redis": {
      "entry": ["src/index.ts", ".eslintrc.{js,cjs}"],
      "project": ["src/**/*.ts"]
    },
    "packages/rate-limiter": {
      "entry": ["src/index.ts", ".eslintrc.{js,cjs}"],
      "project": ["src/**/*.ts"]
    },
    "packages/eval": {
      "entry": ["tests/**/*.py"],
      "project": ["**/*.{py,toml}"]
    },
    "packages/contract": {
      "entry": ["src/index.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["pg"],
      "ignore": ["src/schemas/machine-types.schema.ts"]
    },
    "packages/agents": {
      "entry": ["src/index.ts", ".eslintrc.{js,cjs}"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@babel/preset-typescript"]
    }
  },
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "binaries": "warn",
    "exports": "warn",
    "nsExports": "warn",
    "types": "warn",
    "nsTypes": "warn",
    "duplicates": "warn",
    "unresolved": "warn",
    "catalog": "warn"
  },
  "ignoreExportsUsedInFile": true
}
