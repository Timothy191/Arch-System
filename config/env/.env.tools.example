# Docker Tools Stack Environment Template
# ──────────────────────────────────────────────
# PURPOSE: Environment variables for docker-compose.tools.yml
# USAGE:   Copy to .env.tools and fill in actual values
# SEE:     ENVIRONMENT_FILES_GUIDE.md for detailed usage
# ──────────────────────────────────────────────

# ── N8N Workflow Automation ────────────────────
N8N_ENCRYPTION_KEY=your-n8n-encryption-key

# ── Flowise AI Workflows ───────────────────────
FLOWISE_SECRETKEY_OVERWRITE=your-flowise-secret-key

# ── Tool Admin Credentials (shared across n8n, Flowise, Langfuse) ──
TOOL_ADMIN_EMAIL=admin@example.com
TOOL_ADMIN_PASSWORD=your-admin-password
TOOL_NEXTAUTH_SECRET=your-nextauth-secret
TOOL_SALT=your-salt-value
TOOL_ENCRYPTION_KEY=your-encryption-key

# ── Langfuse Observability ─────────────────────
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=your-langfuse-db-password
LANGFUSE_DB_NAME=langfuse

# ── ClickHouse Analytics (for Langfuse) ──────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password

# ── Redis ──────────────────────────────────────
REDIS_PASSWORD=your-redis-password

# ── Cloudflare & Cloudflare R2 S3 Storage ──────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

