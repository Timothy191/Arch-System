{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@repo/auth/ui": ["libs/features/auth/ui/src/index.ts"],
      "@repo/auth/data-access": ["libs/features/auth/data-access/src/index.ts"],
      "@repo/auth/utils": ["libs/features/auth/utils/src/index.ts"],
      "@repo/departments/ui": ["libs/features/departments/ui/src/index.ts"],
      "@repo/departments/data-access": ["libs/features/departments/data-access/src/index.ts"],
      "@repo/hub/ui": ["libs/features/hub/ui/src/index.ts"],
      "@repo/shared/data-access": ["libs/shared/data-access/src/index.ts"],
      "@repo/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@repo/shared/hooks": ["libs/shared/hooks/src/index.ts"],
      "@repo/ui": ["packages/ui/src/index.ts"],
      "@repo/ui/*": ["packages/ui/src/*"],
      "@repo/contract": ["packages/contract/src/index.ts"],
      "@repo/contract/*": ["packages/contract/src/*"],
      "@repo/utils": ["packages/utils/src/index.ts"],
      "@repo/utils/*": ["packages/utils/src/*"],
      "@repo/database": ["packages/database/src/index.ts"],
      "@repo/database/*": ["packages/database/src/*"],
      "@repo/agents": ["packages/agents/src/index.ts"],
      "@repo/agents/*": ["packages/agents/src/*"],
      "@repo/supabase": ["packages/supabase/src/index.ts"],
      "@repo/supabase/*": ["packages/supabase/src/*"],
      "@repo/theme": ["packages/theme/src/index.ts"],
      "@repo/theme/*": ["packages/theme/src/*"],
      "@repo/logger": ["packages/logger/src/index.ts"],
      "@repo/logger/*": ["packages/logger/src/*"],
      "@repo/rate-limiter": ["packages/rate-limiter/src/index.ts"],
      "@repo/rate-limiter/*": ["packages/rate-limiter/src/*"],
      "@repo/redis": ["packages/redis/src/index.ts"],
      "@repo/redis/*": ["packages/redis/src/*"],
      "@repo/errors": ["packages/errors/src/index.ts"],
      "@repo/errors/*": ["packages/errors/src/*"],
      "@repo/eval": ["packages/eval/src/index.ts"],
      "@repo/eval/*": ["packages/eval/src/*"],
      "@/*": ["apps/portal/*"]
    }
  },
  "exclude": ["node_modules"]
}
