export PATH="/home/tim/.local/share/mise/installs/node/24.15.0/bin:$HOME/.local/share/mise/shims:$HOME/.volta/bin:$PATH"

publish_ci_status() {
  local head_sha
  head_sha="$(git rev-parse HEAD 2>/dev/null || true)"
  if [ -n "$head_sha" ] && [ -f "tools/scripts/autonomous-ci-gatekeeper.mjs" ]; then
    (sleep 3 && node tools/scripts/autonomous-ci-gatekeeper.mjs --from-evidence --sha "$head_sha" >/dev/null 2>&1) &
  fi
}

if [ "${FORCE_AGENT_VERIFY:-0}" != "1" ] && [ -f ".ci-local/agent-verify-evidence.json" ] && [ -z "$(git status --porcelain 2>/dev/null)" ]; then
  HEAD_TREE_HASH="$(git rev-parse 'HEAD^{tree}' 2>/dev/null || echo '')"
  if HEAD_TREE_HASH="$HEAD_TREE_HASH" node -e '
    const fs = require("node:fs");
    const ev = JSON.parse(fs.readFileSync(".ci-local/agent-verify-evidence.json", "utf8"));
    const ageMs = Date.now() - new Date(ev.completedAt || 0).getTime();
    const headTree = process.env.HEAD_TREE_HASH;
    // Compare against totalGates (not a hardcoded 27/28) and gitTreeHash so
    // the fast-path stays valid only for the exact verified tree within 15m.
    if (
      headTree &&
      ev.gitTreeHash === headTree &&
      ev.passedGates === ev.totalGates &&
      ev.failedGates === 0 &&
      ageMs >= 0 &&
      ageMs <= 900000
    ) {
      console.log(`⚡ [PRE-PUSH] Verified ${ev.passedGates}/${ev.totalGates} gate evidence (${Math.round(ageMs / 1000)}s old, runId=${ev.runId}) — skipping redundant second run.`);
      process.exit(0);
    }
    process.exit(1);
  ' 2>/dev/null; then
    publish_ci_status
    exit 0
  fi
fi

pnpm turbo:affected:type-check && node tools/scripts/biome-parse-guard.cjs --pre-push && bash tools/scripts/agent-verify.sh && publish_ci_status
