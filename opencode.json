{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": ["npx", "-y", "codebase-memory-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "inngest": {
      "type": "remote",
      "url": "http://127.0.0.1:8288/mcp",
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@0.3.10"],
      "enabled": true
    },
    "notebooklm": {
      "type": "local",
      "command": ["notebooklm-mcp"],
      "enabled": true
    },
    "npm-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mikusnuz/npm-mcp"],
      "enabled": true
    },
    "nx-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@nx/mcp-server@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.76"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:54322/postgres"
      ],
      "enabled": true
    },
    "redis": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "redis-mcp-server@latest",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ],
      "enabled": true
    }
  }
}
