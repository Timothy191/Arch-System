{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arch-systems-workflows",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },

  "workflows": [
    {
      "binding": "SHIFT_REPORT_WORKFLOW",
      "name": "shift-report-escalation",
      "class_name": "ShiftReportWorkflow",
    },
  ],

  "r2_buckets": [
    {
      "binding": "SPATIAL_TELEMETRY_BUCKET",
      "bucket_name": "arch-spatial-telemetry-media",
      "preview_bucket_name": "arch-spatial-telemetry-media-dev",
    },
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "FUXA_SCADA_URL": "https://fuxa.production-mining.com",
  },

  "triggers": {
    "crons": ["0 6,14,22 * * *"],
  },
}
