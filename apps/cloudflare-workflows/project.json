{
  "name": "@repo/cloudflare-workflows",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cloudflare-workflows/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @repo/cloudflare-workflows type-check"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/cloudflare-workflows"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest",
        "cwd": "apps/cloudflare-workflows"
      }
    }
  },
  "tags": ["scope:app", "type:app", "scope:app:cloudflare-workflows"]
}
