{
  "name": "portal",
  "tags": ["scope:app", "scope:app:portal"],
  "targets": {
    "sync-assets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/sync-assets.sh"
      },
      "inputs": [
        "{workspaceRoot}/assets/**/*",
        "{workspaceRoot}/scripts/sync-assets.sh"
      ],
      "outputs": [
        "{projectRoot}/public/background",
        "{projectRoot}/public/error-pages",
        "{projectRoot}/public/large"
      ],
      "cache": true
    }
  }
}
