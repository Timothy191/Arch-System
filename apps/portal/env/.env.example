NEXT_PUBLIC_SUPABASE_URL=https://mrwhtxbhrzyttlsyuofc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xusUcCYxZKn7zosSmoW6iQ_5qVl03XT

# Server-only keys
SUPABASE_URL=https://mrwhtxbhrzyttlsyuofc.supabase.co
# service_role key — REQUIRED; bypasses RLS and must never be exposed to the client.
# Used by admin/data routes, c66, shift-integrity jobs, warmup, and hourly-loads.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1yd2h0eGJocnp5dHRsc3l1b2ZjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Njc3NzA4MywiZXhwIjoyMTAyMzUzMDgzfQ.iPXzOvs8RanPA5hI33f8x2_ThgR7h72E41vRHDxkOh8
SUPABASE_ANON_KEY=sb_publishable_xusUcCYxZKn7zosSmoW6iQ_5qVl03XT

# Read replica — N/A for hosted Supabase (falls back to NEXT_PUBLIC_SUPABASE_URL when unset)
# SUPABASE_READ_REPLICA_URL=

# AI functionality has been removed

# Redis — used for rate limiting, department slug cache, and session data
# Default connects to local Redis; override for remote/production instances
REDIS_URL=redis://localhost:6379

# Sentry — error monitoring
# Server-side (instrumentation.ts): required for Server Actions, API routes, background jobs
SENTRY_DSN=
# Client-side (sentry.client.config.ts): required for browser error capture
NEXT_PUBLIC_SENTRY_DSN=
# Set by CI/Vercel automatically; override manually if needed
# SENTRY_ORG=your_org
# SENTRY_PROJECT=your_project

# Hardware access-control scanner (optional — defaults shown)
# Comma-separated list of allowed x-scanner-source header values
# ALLOWED_SCANNER_SOURCES=C66-HARDWARE,C66-SCANNER,GATE-TERMINAL

# OpenTelemetry (optional — only activates when OTEL_EXPORTER_OTLP_ENDPOINT is set)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=arch-portal
