# ──────────────────────────────────────────────
# Portal Application — Environment Configuration
# ──────────────────────────────────────────────
# PURPOSE: Portal-specific environment configuration template
# USAGE: Copy this file to .env and fill in actual values
# COMMAND: cp .env.example .env
# WARNING: Never commit the actual .env file with real secrets
# SEE: ../../ENVIRONMENT_FILES_GUIDE.md for detailed usage instructions
# ──────────────────────────────────────────────

# External Tools
N8N_URL=http://localhost:5678
N8N_USER=admin@example.com
N8N_PASSWORD=...

FLOWISE_URL=http://localhost:3001
FLOWISE_USER=admin@example.com
FLOWISE_PASSWORD=...
NEXT_PUBLIC_FUXA_URL=http://localhost:1881

# Supabase Configuration — Cloud Supabase (default)
# Project ref: mrwhtxbhrzyttlsyuofc
# Data API (PostgREST): https://mrwhtxbhrzyttlsyuofc.supabase.co/rest/v1/
# Replace placeholders with keys from Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://mrwhtxbhrzyttlsyuofc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_d-7-pJnWomgpNtWFFy_yCA_4axrPll5

# Server-only keys
SUPABASE_URL=https://mrwhtxbhrzyttlsyuofc.supabase.co
# service_role key — REQUIRED; bypasses RLS and must never be exposed to the client.
# Used by admin/data routes, c66, shift-integrity jobs, warmup, and hourly-loads.
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Additional Supabase credentials documented for reference.
# The current portal code only consumes the variables above; add these to the
# schema in libs/shared/utils/src/env.ts if you need to reference them at runtime.
# Secret key (new format, equivalent to service_role): sb_secret_your-secret-key-here
# Anon public JWT: your-anon-jwt-here
# Service role secret JWT: your-service-role-jwt-here
# Legacy JWT secret: your-legacy-jwt-secret-here

# Read replica — N/A for Cloud Supabase (falls back to NEXT_PUBLIC_SUPABASE_URL when unset)
# SUPABASE_READ_REPLICA_URL=

# Google AI (Gemini) - Primary AI provider for token tracking
# Google Project: Arch-system (arch-system-9b0e6)
GOOGLE_PROJECT_ID=arch-system-9b0e6
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Redis — used for rate limiting, department slug cache, and session data
# Default connects to local Redis; override for remote/production instances
REDIS_URL=redis://localhost:6379

# Sentry — error monitoring
# Server-side (instrumentation.ts): required for Server Actions, API routes, background jobs
SENTRY_DSN=
# Client-side (sentry.client.config.ts): required for browser error capture
NEXT_PUBLIC_SENTRY_DSN=
# Set by CI/Vercel automatically; override manually if needed
# SENTRY_ORG=your_org
# SENTRY_PROJECT=your_project

# Hardware access-control scanner (optional — defaults shown)
# Comma-separated list of allowed x-scanner-source header values
# ALLOWED_SCANNER_SOURCES=C66-HARDWARE,C66-SCANNER,GATE-TERMINAL

# OpenTelemetry (optional — only activates when OTEL_EXPORTER_OTLP_ENDPOINT is set)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=arch-portal
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORTAL_VERSION=2.4.1
