# Production Environment Configuration
# Copy this file to .env and fill in actual values for production deployment

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Configuration
# ─────────────────────────────────────────────────────────────────────────────
# For production, use external Supabase or self-hosted with public domain
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key

# Server-only keys (load from secrets vault in production)
SUPABASE_URL=https://your-production-project.supabase.co
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_KEY loaded from secrets vault

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD loaded from secrets vault

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring & Observability
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=arch-systems
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=arch-portal

# ─────────────────────────────────────────────────────────────────────────────
# External Tools
# ─────────────────────────────────────────────────────────────────────────────
N8N_URL=http://localhost:5678
N8N_USER=admin@example.com
N8N_PASSWORD=your-n8n-password
N8N_ENCRYPTION_KEY=your-n8n-encryption-key

FLOWISE_URL=http://localhost:3001
FLOWISE_USER=admin@example.com
FLOWISE_PASSWORD=your-flowise-password

NEXT_PUBLIC_FUXA_URL=http://localhost:1881

# ─────────────────────────────────────────────────────────────────────────────
# Grafana Monitoring
# ─────────────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD loaded from secrets vault
GRAFANA_URL=https://grafana.plantcor.os

# ─────────────────────────────────────────────────────────────────────────────
# Cloud Backup Configuration (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# AWS S3
# S3_BACKUP_BUCKET=arch-systems-backups
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key

# Google Cloud Storage
# GCS_BACKUP_BUCKET=arch-systems-backups
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Azure Storage
# AZURE_BACKUP_CONTAINER=arch-backups
# AZURE_STORAGE_ACCOUNT=your-storage-account
# AZURE_STORAGE_KEY=your-storage-key

# ─────────────────────────────────────────────────────────────────────────────
# JWT & Security
# ─────────────────────────────────────────────────────────────────────────────
# JWT_SECRET loaded from secrets vault

# ─────────────────────────────────────────────────────────────────────────────
# Notifications
# ─────────────────────────────────────────────────────────────────────────────
# NOVU_API_KEY=your-novu-api-key
# INNGEST_EVENT_KEY=your-inngest-event-key

# ─────────────────────────────────────────────────────────────────────────────
# Slack Alerts (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
