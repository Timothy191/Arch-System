# ─────────────────────────────────────────────────────────────────
# Arch-Systems Portal — Production Environment Template
# ─────────────────────────────────────────────────────────────────
# PURPOSE: Production deployment environment configuration template
# USAGE: Copy to .env and fill in all required values before deploying
# WARNING: NEVER commit this file with real secrets
# SEE: ../../ENVIRONMENT_FILES_GUIDE.md for detailed production deployment
# ─────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────
# Replace 127.0.0.1 with the on-premises server's LAN IP address if remote.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon-placeholder
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon-placeholder
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service-role-placeholder

# Read replica (optional — omit if not running docker-compose.replica.yml)
SUPABASE_READ_REPLICA_URL=http://127.0.0.1:54322

# ── AI functionality has been removed ─────────────────────────────────

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://:arch-systems-redis-secret@localhost:6379
# Must match REDIS_PASSWORD in docker-compose.production.yml
REDIS_PASSWORD=arch-systems-redis-secret

# ── External Tools ────────────────────────────────────────────────
N8N_URL=http://localhost:5678
N8N_USER=admin@example.com
N8N_PASSWORD=arch-systems-n8n-secret
N8N_ENCRYPTION_KEY=arch-systems-encryption-key-placeholder

FLOWISE_URL=http://localhost:3001
FLOWISE_USER=admin@example.com
FLOWISE_PASSWORD=arch-systems-flowise-secret
FLOWISE_SECRETKEY_OVERWRITE=arch-systems-flowise-api-key

# ── Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=https://placeholder@sentry.io/placeholder

# ── Langfuse (LLM Observability) ─────────────────────────────────
LANGFUSE_URL=http://localhost:3002

# ── Deployment Notifications (optional) ──────────────────────────
# If set, deploy-production.sh will POST to this URL on successful deploy.
# Create an n8n webhook trigger and paste the URL here.
DEPLOY_WEBHOOK_URL=http://localhost:5678/webhook/deployment-success

# ── Next.js ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=arch-systems-next-auth-secret-placeholder
