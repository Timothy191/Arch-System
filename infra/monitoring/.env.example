# Optional settings for infra/monitoring/docker-compose.yml.
# Copy to infra/monitoring/.env (gitignored) and adjust values, then run
# `pnpm monitor:grafana`. Every value has a safe default; the stack boots
# without this file. If your Compose version does not auto-load this directory's
# .env, pass it explicitly:
#   docker compose --env-file infra/monitoring/.env -f infra/monitoring/docker-compose.yml up -d

# Grafana admin login (defaults: admin / admin).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Alertmanager has no env-var expansion. To deliver alerts, copy
# infra/observability/alertmanager.yml to a gitignored local file, insert real
# Slack/PagerDuty credentials, and point ALERTMANAGER_CONFIG_PATH at it.
# ALERTMANAGER_CONFIG_PATH=../observability/alertmanager.local.yml

# Optional Woodpecker CI profile (`--profile ci`).
WOODPECKER_HOST=http://localhost:8000
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=
WOODPECKER_AGENT_SECRET=
