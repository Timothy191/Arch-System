{
  "title": "Arch-System Hybrid L1/L2 Redis 7.x & AI Cache Telemetry",
  "uid": "arch-redis-cache-v2",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cache Hits (L1 Memory vs L2 Redis 7.x) & Misses",
      "targets": [
        {
          "expr": "rate(portal_cache_hits_total{source=\"l1\"}[5m])",
          "legendFormat": "L1 In-Memory Hits"
        },
        {
          "expr": "rate(portal_cache_hits_total{source=\"l2\"}[5m])",
          "legendFormat": "L2 Redis 7.x Hits"
        },
        {
          "expr": "rate(portal_cache_misses_total[5m])",
          "legendFormat": "Cache Misses"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cache Access Latency (Avg vs p95 ms)",
      "targets": [
        {
          "expr": "portal_cache_latency_ms{metric=\"avg\"}",
          "legendFormat": "Avg Latency (ms)"
        },
        {
          "expr": "portal_cache_latency_ms{metric=\"p95\"}",
          "legendFormat": "p95 Latency (ms)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "X-Fetch Stampede Prevention Triggers",
      "targets": [
        {
          "expr": "portal_cache_xfetch_triggers_total",
          "legendFormat": "X-Fetch Early Refreshes"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Redis Errors",
      "targets": [
        {
          "expr": "portal_cache_errors_total",
          "legendFormat": "Errors"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
