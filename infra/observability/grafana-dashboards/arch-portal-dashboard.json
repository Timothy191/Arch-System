{
  "uid": "arch-portal-golden-signals",
  "title": "Arch Portal Golden Signals",
  "tags": ["arch-system", "portal", "golden-signals"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Redis L1/L2 Cache Hits",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(portal_cache_hits_total)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache Misses",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "portal_cache_misses_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache p95 Latency (ms)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "portal_cache_latency_ms{metric=\"p95\"}", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Inngest Job Executions",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "portal_inngest_job_executions_total", "refId": "A" }]
    }
  ]
}
