# Production Cloudflare Tunnel Configuration for Arch-System
# Exposes Next.js Portal, FUXA SCADA, and Backend APIs securely via Cloudflare Edge CDN & Zero Trust.
#
# Usage:
#   1. Create tunnel:  cloudflared tunnel create arch-system-tunnel
#   2. Bind DNS:       cloudflared tunnel route dns arch-system-tunnel portal.yourdomain.com
#   3. Run tunnel:     cloudflared tunnel --config infra/cloudflared/production-tunnel.yml run

tunnel: 7f8a9b0c-1d2e-3f4a-5b6c-7d8e9f0a1b2c
credentials-file: /etc/cloudflared/creds/7f8a9b0c-1d2e-3f4a-5b6c-7d8e9f0a1b2c.json

# Global Origin Requests configuration
originRequest:
  connectTimeout: 30s
  keepAliveTimeout: 90s
  noTLSVerify: false

ingress:
  # 1. Main Next.js Portal Web Application
  - hostname: portal.yourdomain.com
    service: http://127.0.0.1:3000
    originRequest:
      http2Origin: true
      keepAliveConnections: 100

  # 2. On-Prem FUXA SCADA UI & Real-Time Telemetry Stream
  - hostname: fuxa.yourdomain.com
    service: http://127.0.0.1:8088
    originRequest:
      http2Origin: true
      connectTimeout: 30s

  # 3. SCADA API / OPC-UA Data Proxy Endpoint
  - hostname: fuxa-api.yourdomain.com
    service: http://127.0.0.1:8088
    originRequest:
      connectTimeout: 15s
      keepAliveConnections: 100

  # 4. Optional: Local Supabase REST & WebSockets (if hosting backend on-prem)
  - hostname: supabase-api.yourdomain.com
    service: http://127.0.0.1:54321

  # 5. Catch-all fallback rule (required by cloudflared)
  - service: http_status:404
