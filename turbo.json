{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "tsconfig.base.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    ".npmrc",
    "biome.json"
  ],
  "globalEnv": ["NODE_ENV", "VERCEL_ENV", "CI"],
  "globalPassThroughEnv": [
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_SERVICE_NAME",
    "INNGEST_EVENT_KEY",
    "NOVU_API_KEY",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_KEY",
    "METABASE_SECRET_KEY",
    "REDIS_URL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        "!**/*.stories.*",
        "!**/.storybook/**",
        "!**/tsconfig.storybook.json"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "ANALYZE",
        "PORTAL_VERSION",
        "SITE_URL",
        "SITE_NAME",
        "DISABLE_RATE_LIMIT",
        "NEXT_PUBLIC_*"
      ],
      "cache": true
    },
    "@repo/swarms-orchestrator#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "Cargo.toml", "Cargo.lock"],
      "outputs": ["target/release/swarms-orchestrator", "target/release/swarms-orchestrator.exe"],
      "cache": true
    },
    "build-storybook": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/*.spec.*", "!**/__tests__/**"],
      "outputs": ["storybook-static/**", "dist/**"],
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "codegen": {
      "inputs": [
        "src/css/variables.css",
        "scripts/generate-tokens.mjs",
        "sd.config.mjs",
        "tokens.json"
      ],
      "outputs": ["src/tokens/generated.ts", "src/css/index.css"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "biome.json", ".eslintrc.*"],
      "outputs": [],
      "cache": true
    },
    "lint:css": {
      "inputs": ["src/**/*.css", "**/*.css", ".stylelintrc.*", "config/tools/.stylelintignore"],
      "outputs": [],
      "cache": true
    },
    "lint:tokens": {
      "inputs": ["src/css/variables.css", "src/tailwind/preset.ts", "scripts/validate-tokens.mjs"],
      "outputs": [],
      "cache": true
    },
    "sync-assets": {
      "inputs": ["assets/**/*", "scripts/sync-assets-smart.cjs"],
      "outputs": ["public/background/**", "public/error-pages/**", "public/large/**"],
      "cache": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "playwright.config.*"],
      "outputs": [],
      "cache": true
    },
    "test:coverage": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "type-check": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "tsconfig.*.json"],
      "outputs": [],
      "cache": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
