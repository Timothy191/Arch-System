{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "pnpm-workspace.yaml", ".npmrc"],
  "globalEnv": ["NODE_ENV", "VERCEL_ENV", "CI"],
  "globalPassThroughEnv": ["OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_SERVICE_NAME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        "!**/*.stories.*",
        "!**/.storybook/**",
        "!**/tsconfig.storybook.json"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "ANALYZE",
        "PORTAL_VERSION",
        "SITE_URL",
        "SITE_NAME",
        "DISABLE_RATE_LIMIT",
        "NEXT_PUBLIC_*"
      ],
      "cache": true
    },
    "portal#build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        "!**/*.stories.*",
        "!**/.storybook/**",
        "!**/tsconfig.storybook.json"
      ],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "ANALYZE",
        "PORTAL_VERSION",
        "SITE_URL",
        "SITE_NAME",
        "DISABLE_RATE_LIMIT",
        "NEXT_PUBLIC_*"
      ],
      "passThroughEnv": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWKS_URL",
        "SUPABASE_JWT_SECRET",
        "SUPABASE_JWT_LEGACY_SECRET",
        "SUPABASE_DATA_API_URL",
        "SUPABASE_READ_REPLICA_URL",
        "SUPABASE_STUDIO_URL",
        "SUPABASE_DATABASE_URL",
        "DATABASE_URL",
        "DATABASE_POOLER_URL",
        "REDIS_URL",
        "SERVERLESS_REDIS_URL",
        "REDIS_AUTH_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "CRON_SECRET",
        "SCANNER_API_KEY",
        "ALLOWED_SCANNER_SOURCES",
        "TELEMETRY_INGEST_SECRET",
        "TELEMETRY_STREAM_SECRET",
        "TELEMETRY_WEBHOOK_SECRET",
        "WEBHOOK_SECRET",
        "VERCEL_WEBHOOK_SECRET",
        "VERCEL_DRAIN_SECRET",
        "VERCEL_DRAIN_VERIFY",
        "METABASE_SECRET_KEY",
        "INNGEST_EVENT_KEY",
        "NOVU_API_KEY",
        "DISPATCH_API_KEY",
        "PORTAL_BASE",
        "AION_BASE_URL",
        "AIML_BASE_URL",
        "COHERE_BASE_URL",
        "COHERE_OPENAI_COMPAT_URL",
        "AI_GATEWAY_BASE_URL",
        "AI_GATEWAY_MODEL",
        "SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "N8N_USER",
        "N8N_PASSWORD",
        "N8N_ENCRYPTION_KEY",
        "FLOWISE_URL",
        "FLOWISE_USER",
        "FLOWISE_PASSWORD",
        "PAYLOAD_SECRET",
        "SLACK_WEBHOOK_URL",
        "SLO_DASHBOARD_URL",
        "INTEGRATION_ENCRYPTION_KEY",
        "INTEGRATIONS_MANIFEST_TOKEN",
        "GOOGLE_PROJECT_ID",
        "GOOGLE_AI_API_KEY",
        "GEMINI_API_KEY",
        "GEMINI_API_KEYS",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "OPENROUTER_API_KEY",
        "OPENROUTER_MODEL",
        "WORKOS_CLIENT_ID",
        "WORKOS_API_KEY",
        "SIXTYFOUR_API_KEY",
        "WINDSOR_API_KEY",
        "AGENTY_API_KEY"
      ],
      "cache": true
    },
    "portal#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWKS_URL",
        "SUPABASE_JWT_SECRET",
        "SUPABASE_JWT_LEGACY_SECRET",
        "SUPABASE_DATA_API_URL",
        "SUPABASE_READ_REPLICA_URL",
        "SUPABASE_STUDIO_URL",
        "SUPABASE_DATABASE_URL",
        "DATABASE_URL",
        "DATABASE_POOLER_URL",
        "REDIS_URL",
        "SERVERLESS_REDIS_URL",
        "REDIS_AUTH_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "CRON_SECRET",
        "SCANNER_API_KEY",
        "ALLOWED_SCANNER_SOURCES",
        "TELEMETRY_INGEST_SECRET",
        "TELEMETRY_STREAM_SECRET",
        "TELEMETRY_WEBHOOK_SECRET",
        "WEBHOOK_SECRET",
        "VERCEL_WEBHOOK_SECRET",
        "VERCEL_DRAIN_SECRET",
        "VERCEL_DRAIN_VERIFY",
        "METABASE_SECRET_KEY",
        "INNGEST_EVENT_KEY",
        "NOVU_API_KEY",
        "DISPATCH_API_KEY",
        "PORTAL_BASE",
        "AION_BASE_URL",
        "AIML_BASE_URL",
        "COHERE_BASE_URL",
        "COHERE_OPENAI_COMPAT_URL",
        "AI_GATEWAY_BASE_URL",
        "AI_GATEWAY_MODEL",
        "SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "N8N_USER",
        "N8N_PASSWORD",
        "N8N_ENCRYPTION_KEY",
        "FLOWISE_URL",
        "FLOWISE_USER",
        "FLOWISE_PASSWORD",
        "PAYLOAD_SECRET",
        "SLACK_WEBHOOK_URL",
        "SLO_DASHBOARD_URL",
        "INTEGRATION_ENCRYPTION_KEY",
        "INTEGRATIONS_MANIFEST_TOKEN",
        "GOOGLE_PROJECT_ID",
        "GOOGLE_AI_API_KEY",
        "GEMINI_API_KEY",
        "GEMINI_API_KEYS",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "OPENROUTER_API_KEY",
        "OPENROUTER_MODEL",
        "WORKOS_CLIENT_ID",
        "WORKOS_API_KEY",
        "SIXTYFOUR_API_KEY",
        "WINDSOR_API_KEY",
        "AGENTY_API_KEY"
      ]
    },
    "portal#test": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*"],
      "outputs": [],
      "passThroughEnv": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "DATABASE_URL",
        "DATABASE_POOLER_URL",
        "REDIS_URL",
        "CRON_SECRET",
        "SCANNER_API_KEY",
        "ALLOWED_SCANNER_SOURCES",
        "TELEMETRY_INGEST_SECRET",
        "TELEMETRY_STREAM_SECRET",
        "TELEMETRY_WEBHOOK_SECRET",
        "WEBHOOK_SECRET",
        "VERCEL_WEBHOOK_SECRET",
        "VERCEL_DRAIN_SECRET",
        "VERCEL_DRAIN_VERIFY"
      ],
      "cache": true
    },
    "portal#test:integration": {
      "cache": false,
      "passThroughEnv": [
        "REDIS_URL",
        "REDIS_INTEGRATION",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN"
      ]
    },
    "@repo/redis#test:integration": {
      "cache": false,
      "passThroughEnv": [
        "REDIS_URL",
        "REDIS_INTEGRATION",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN"
      ]
    },
    "@repo/database#test": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_SERVICE_ROLE_KEY"
      ],
      "cache": true
    },
    "@repo/swarms-orchestrator#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "Cargo.toml", "Cargo.lock"],
      "outputs": ["target/release/swarms-orchestrator", "target/release/swarms-orchestrator.exe"],
      "cache": true
    },
    "build-storybook": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/*.spec.*", "!**/__tests__/**"],
      "outputs": ["storybook-static/**", "dist/**"],
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "codegen": {
      "inputs": [
        "src/css/variables.css",
        "scripts/generate-tokens.mjs",
        "sd.config.mjs",
        "tokens.json"
      ],
      "outputs": ["src/tokens/generated.ts", "src/css/index.css"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "biome.json", ".eslintrc.*"],
      "outputs": [],
      "cache": true
    },
    "lint:css": {
      "inputs": ["src/**/*.css", "**/*.css", ".stylelintrc.*", "config/tools/.stylelintignore"],
      "outputs": [],
      "cache": true
    },
    "lint:tokens": {
      "inputs": ["src/css/variables.css", "src/tailwind/preset.ts", "scripts/validate-tokens.mjs"],
      "outputs": [],
      "cache": true
    },
    "sync-assets": {
      "inputs": ["assets/**/*", "scripts/sync-assets-smart.cjs"],
      "outputs": ["public/background/**", "public/error-pages/**", "public/large/**"],
      "cache": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "playwright.config.*"],
      "outputs": [],
      "cache": true
    },
    "test:coverage": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "type-check": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "tsconfig.*.json"],
      "outputs": [],
      "cache": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
