{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "workspaces": {
    "patterns": [
      "tools/swarms-orchestrator",
      "tools/zero-drift-watchdog",
      "apps/*",
      "packages/*",
      "scripts",
      "libs/features/*/*",
      "libs/shared/*",
      "scripts/seeds"
    ]
  },
  "ignorePatterns": ["**/node_modules/**", "**/.next/**", "**/dist/**", "**/coverage/**"]
}
