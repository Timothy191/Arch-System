# ──────────────────────────────────────────────
# Arch Systems — Required Environment Variables
# ──────────────────────────────────────────────
# PURPOSE: Root-level environment configuration template
# USAGE: Copy this file to .env and fill in actual values
# COMMAND: cp .env.example .env
# WARNING: Never commit the actual .env file with real secrets
# SEE: ENVIRONMENT_FILES_GUIDE.md for detailed usage instructions
# ──────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=8000

# ── Supabase ──────────────────────────────────
# Cloud project: https://supabase.com/dashboard/project/<project-ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
# Secret key — server-side only, never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# JWT secrets (Dashboard → Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=your_jwt_secret_here
SUPABASE_JWT_LEGACY_SECRET=your_legacy_jwt_secret_here
# Data API
SUPABASE_DATA_API_URL=https://<project-ref>.supabase.co/rest/v1/
# Read replica — cloud pooler Session mode (port 5432), or same URL if no replica configured
SUPABASE_READ_REPLICA_URL=https://<project-ref>.supabase.co
SUPABASE_STUDIO_URL=https://supabase.com/dashboard/project/<project-ref>
# DB password: Dashboard → Settings → Database
DATABASE_URL=postgresql://postgres.<project-ref>:your_db_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543) — recommended for serverless/edge functions
DATABASE_POOLER_URL=postgresql://postgres.<project-ref>:your_db_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── AI / LLM ──────────────────────────────────
# Gemini API Key (1,500 free RPD via Google AI Studio / OpenAI compatible endpoint)
GEMINI_API_KEY=
# Aion Labs API Key & Base URL (Permanent free tier: 15 RPM, 20K TPD, reasoning & roleplay)
AION_API_KEY=
AION_BASE_URL=https://api.aionlabs.ai/v1
# AI/ML API Key & Base URL (Free tier: 15 RPM, multiple open models via OpenAI-compatible API)
AIML_API_KEY=
AIML_BASE_URL=https://api.aimlapi.com/v1
# Cohere API Key & URLs (Free trial: 20 RPM, 1,000 calls/month, Command A/R models)
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_OPENAI_COMPAT_URL=https://api.cohere.com/compatibility/v1
# API-Ninjas Key & MCP Endpoint
API_NINJAS_API_KEY=
API_NINJAS_MCP_URL=https://mcp.api-ninjas.com/mcp
# OpenRouter API Key (Access to free and open-source models)
OPENROUTER_API_KEY=
# Optional: Local Ollama (http://127.0.0.1:11434/v1) or Puter.js
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Monitoring / Observability ────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=arch-portal
SENTRY_DSN=...
NEXT_PUBLIC_SENTRY_DSN=...
SENTRY_ORG=...
SENTRY_PROJECT=...
SENTRY_AUTH_TOKEN=...

# ── Tools (n8n / Flowise) ────────────────────
N8N_URL=http://localhost:5678
N8N_USER=admin
N8N_PASSWORD=...
N8N_ENCRYPTION_KEY=...
FLOWISE_URL=http://localhost:3001
FLOWISE_USER=admin
FLOWISE_PASSWORD=...
NEXT_PUBLIC_FUXA_URL=http://localhost:1881
# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Notifications / Events ───────────────────
NOVU_API_KEY=...
INNGEST_EVENT_KEY=...

# ── Payload CMS ──────────────────────────────
PAYLOAD_SECRET=...

# ── Next.js Build ────────────────────────────
# SKIP_TYPE_CHECK=true
# ENABLE_HEAVY_PLUGINS=true
# ANALYZE=true

# ── Alerting / Monitoring ────────────────────
SLACK_WEBHOOK_URL=...
SLO_DASHBOARD_URL=...
