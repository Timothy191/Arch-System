# ──────────────────────────────────────────────
# Arch Systems — Required Environment Variables
# ──────────────────────────────────────────────
# PURPOSE: Root-level environment configuration template
# USAGE: Copy this file to .env and fill in actual values
# COMMAND: cp .env.example .env
# WARNING: Never commit the actual .env file with real secrets
# SEE: ENVIRONMENT_FILES_GUIDE.md for detailed usage instructions
# ──────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=8000

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_READ_REPLICA_URL=http://127.0.0.1:54322
SUPABASE_STUDIO_URL=http://127.0.0.1:54323
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Connection Pooler URL (for production - use pooler port 54329)
DATABASE_POOLER_URL=postgresql://postgres.iam.auth:your_password@localhost:54329/postgres

# ── AI / LLM ──────────────────────────────────
# Gemini API Key (1,500 free RPD via Google AI Studio / OpenAI compatible endpoint)
GEMINI_API_KEY=
# Aion Labs API Key & Base URL (Permanent free tier: 15 RPM, 20K TPD, reasoning & roleplay)
AION_API_KEY=
AION_BASE_URL=https://api.aionlabs.ai/v1
# Cohere API Key & URLs (Free trial: 20 RPM, 1,000 calls/month, Command A/R models)
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_OPENAI_COMPAT_URL=https://api.cohere.com/compatibility/v1
# API-Ninjas Key & MCP Endpoint
API_NINJAS_API_KEY=
API_NINJAS_MCP_URL=https://mcp.api-ninjas.com/mcp
# OpenRouter API Key (Access to free and open-source models)
OPENROUTER_API_KEY=
# Optional: Local Ollama (http://127.0.0.1:11434/v1) or Puter.js
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Monitoring / Observability ────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=arch-portal
SENTRY_DSN=...
NEXT_PUBLIC_SENTRY_DSN=...
SENTRY_ORG=...
SENTRY_PROJECT=...
SENTRY_AUTH_TOKEN=...

# ── Tools (n8n / Flowise) ────────────────────
N8N_URL=http://localhost:5678
N8N_USER=admin
N8N_PASSWORD=...
N8N_ENCRYPTION_KEY=...
FLOWISE_URL=http://localhost:3001
FLOWISE_USER=admin
FLOWISE_PASSWORD=...
NEXT_PUBLIC_FUXA_URL=http://localhost:1881
# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Notifications / Events ───────────────────
NOVU_API_KEY=...
INNGEST_EVENT_KEY=...

# ── Payload CMS ──────────────────────────────
PAYLOAD_SECRET=...

# ── Next.js Build ────────────────────────────
# SKIP_TYPE_CHECK=true
# ENABLE_HEAVY_PLUGINS=true
# ANALYZE=true

# ── Alerting / Monitoring ────────────────────
SLACK_WEBHOOK_URL=...
SLO_DASHBOARD_URL=...
