{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "checkJs": false,
    "outDir": "dist",
    "rootDir": ".",
    "removeComments": false,
    "importHelpers": true,
    "downlevelIteration": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "jsx": "preserve",
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "coverage",
    "build",
    "*.config.js",
    "*.config.cjs",
    "*.config.mjs"
  ]
}
